# @airing-cal/node-jobs — see apps/node-jobs/docs/operator-contract.md (env, exit codes, timeouts)

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AIRING_CAL_D1_DATABASE_ID=
AIRING_CAL_R2_BUCKET=
# Image bytes for GET /image/:hash. web-worker reads bucket airing-cal-images (binding AIRING_CAL_R2).
# Same S3 credentials as AIRING_CAL_R2_BUCKET. The token must allow PutObject on this bucket.
# Default when unset: airing-cal-images. Do not point this at the snapshot bucket.
AIRING_CAL_IMAGE_BUCKET=airing-cal-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Required for web-worker R2 read path after sync publish
AIRING_CAL_KV_NAMESPACE_ID=

# Sync only
AIRINGCAL_USERS_JSON=
AIRINGCAL_PRIMARY_USER_ID=
BANGUMI_GIT_COMMIT_SHA=
BGM_TOKEN=

# Portable v3 builder (optional). When AIRINGCAL_BUILDER=portable, sync skips Cloudflare D1/R2/KV and writes SQLite checkpoints.
# AIRINGCAL_BUILDER=portable
# AIRINGCAL_BUILDER_SQLITE_PATH=./data/builder.sqlite
# AIRINGCAL_BUILDER_MODE=incremental
# AIRINGCAL_BUILDER_PUBLISH=false
# AIRINGCAL_BUILDER_PUBLIC_DIR=./data/public-store
# AIRINGCAL_BUILDER_MEDIA_REFRESH=skip
# AIRINGCAL_BUILDER_IMAGE_DIR=./data/public-store
# AIRINGCAL_BUILDER_OWNER=qinglong-host-1

# Bangumi image downloads use global fetch. On QingLong, HTTPS_PROXY is applied by the
# wrapper (curl for lain.bgm.tv). Bodies labeled application/json are accepted when the
# bytes are JPEG, PNG, GIF, WebP, or AVIF.

# Cover thumb pipeline (AC-2): batch POST after large image R2 write (fire-and-forget).
# Worker secret name: THUMB_GEN_BEARER (see apps/web-worker/env.example). Omit URL + origin to disable.
# QingLong mirror: QINGLONG-REPO config/env/airingcal-sync.env.example (AIRINGCAL_THUMB_GEN_*).
# Plan (no duplicate spec): https://github.com/Skyline-Gazer/QINGLONG-REPO/blob/ql/docs/plans/airingcal-thumb-pipeline.md
AIRINGCAL_THUMB_GEN_URL=
# Alternative to AIRINGCAL_THUMB_GEN_URL: site origin; client posts to {origin}/api/thumb-gen
# AIRINGCAL_WEB_ORIGIN=
# Same value as web-worker THUMB_GEN_BEARER; required when URL or WEB_ORIGIN is set.
AIRINGCAL_THUMB_GEN_BEARER=

# Optional on QingLong (defaults to OS temp dir for backup SQL staging)
# QL_DATA_DIR=
