# @airing-cal/node-jobs — Local Environment Example
# Canonical operator contract: apps/node-jobs/docs/operator-contract.md

AIRINGCAL_BUILDER=portable
AIRINGCAL_BUILDER_SQLITE_PATH=/tmp/airingcal-builder.sqlite
AIRINGCAL_BUILDER_IMAGE_DIR=/tmp/airingcal-images
AIRINGCAL_BUILDER_PUBLISH=false
AIRINGCAL_BUILDER_MEDIA_REFRESH=skip
AIRINGCAL_FULL_EVERY_DAYS=7
AIRINGCAL_BUILDER_MODE=

# Bangumi sync identity
BGM_TOKEN=
AIRINGCAL_USERS_JSON=
AIRINGCAL_PRIMARY_USER_ID=
BANGUMI_GIT_COMMIT_SHA=

# Private Cloudflare R2 S3-compatible checkpoint & public release target
AIRINGCAL_CHECKPOINT_S3_ENDPOINT=
AIRINGCAL_CHECKPOINT_S3_REGION=auto
AIRINGCAL_CHECKPOINT_S3_BUCKET=airingcal-development
AIRINGCAL_CHECKPOINT_S3_ACCESS_KEY_ID=
AIRINGCAL_CHECKPOINT_S3_SECRET_ACCESS_KEY=
AIRINGCAL_PUBLIC_S3_ENDPOINT=
AIRINGCAL_PUBLIC_S3_REGION=auto
AIRINGCAL_PUBLIC_S3_BUCKET=airingcal-development
AIRINGCAL_PUBLIC_S3_ACCESS_KEY_ID=
AIRINGCAL_PUBLIC_S3_SECRET_ACCESS_KEY=
AIRINGCAL_PUBLIC_BASE_URL=

# Optional Bark push notification URL for Writer failure alerts
# BARK_URL=
