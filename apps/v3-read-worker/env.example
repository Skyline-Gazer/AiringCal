# @airing-cal/v3-read-worker — Local Environment Example (never commit real values)
#
# Bindings in wrangler.toml:
#   AIRINGCAL_R2 -> Private R2 bucket (`airingcal-production` or `airingcal-development`)
#
# Optional Worker vars (materialized automatically during `pnpm run setup`):
#   BANGUMI_GIT_COMMIT_SHA    — 40-char git revision rendered on `/`
#   AIRINGCAL_PUBLIC_BASE_URL — Leave empty for default Worker-origin mode (streams from AIRINGCAL_R2)
#   AIRINGCAL_CORS_ORIGINS    — Comma-separated exact origins for external Widget embeds
#   PACKAGE_VERSION           — Package semver (3.0.0)
BANGUMI_GIT_COMMIT_SHA=
AIRINGCAL_PUBLIC_BASE_URL=
AIRINGCAL_CORS_ORIGINS=
PACKAGE_VERSION=3.0.0
