# gitignored sibling: copy to `.env.production` (never commit)
# (pnpm setup derives these from the two tokens; this file stays the advanced/headless path)
AIRINGCAL_ENV=production
AIRINGCAL_DOTENV_PATH=.env.production
AIRINGCAL_DEPLOY_TARGET=cloudflare
AIRINGCAL_CLOUDFLARE_API_TOKEN=
AIRINGCAL_CLOUDFLARE_ACCOUNT_ID=
# Worker-mode (default) needs no zone; zone is required only for the explicit
# legacy bucket-domain topology or binding a Worker custom domain.
AIRINGCAL_ZONE_ID=
AIRINGCAL_BANGUMI_TOKEN=
AIRINGCAL_PRIMARY_USER_ID=
AIRINGCAL_USERS_JSON=
# Leave unset for Worker-origin mode and streamed images.
AIRINGCAL_PUBLIC_BASE_URL=
# #195: public origin topology is never inferred from a URL host.
# Leave empty for the wizard default (worker mode). Set explicitly only for
# the legacy bucket-domain path: worker | bucket-domain
# AIRINGCAL_PUBLIC_ORIGIN_MODE=
# Optional Worker custom domain (kept independent of bucket domains):
# AIRINGCAL_WORKER_CUSTOM_DOMAIN=
# workers.dev subdomain for the Cloudflare account (default r7a):
# AIRINGCAL_WORKERS_DEV_SUBDOMAIN=
# Supply independently scoped Production S3 credentials if the management
# token cannot derive usable Production S3 access. Apply never rotates tokens
# by name; writer-token rotation needs AIRINGCAL_WRITER_TOKEN_ROTATION_ID=<id>.
# AIRINGCAL_S3_ACCESS_KEY_ID=
# AIRINGCAL_S3_SECRET_ACCESS_KEY=

# Immutable planned resource names (not Owner-editable defaults that can silently drift):
# - Bucket: airingcal-production
# - GitHub Environment: production
# - Bootstrap Manual Gate (workflow_dispatch Full Sync only):
#     GitHub ENVIRONMENT (production) Variable AIRINGCAL_PRODUCTION_BOOTSTRAP_WRITER_ENABLED
#     (checked by the first step inside the production job; must remain unset/false in this prep)
# - Schedule Gate (cron only):
#     GitHub REPOSITORY-level Variable AIRINGCAL_WRITER_ENABLED
#     (job-level `if` can only read repo scope; must remain unset/false in this prep)
# - CF Worker: airingcal-production (canonical #195; legacy
#   airing-cal-v3-read-production is forbidden as a Production target)
# - deploy-env Production: always set AIRINGCAL_DOTENV_PATH to this file's sibling `.env.production`
