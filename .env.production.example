# gitignored sibling: copy to `.env.production` (never commit)
AIRINGCAL_ENV=production
AIRINGCAL_DEPLOY_TARGET=both
AIRINGCAL_CLOUDFLARE_API_TOKEN=
AIRINGCAL_CLOUDFLARE_ACCOUNT_ID=
AIRINGCAL_ZONE_ID=
AIRINGCAL_BANGUMI_TOKEN=
AIRINGCAL_PRIMARY_USER_ID=
AIRINGCAL_PUBLIC_BASE_URL=
# optional image CDN; default unset
# AIRINGCAL_IMAGE_BASE_URL=
AIRINGCAL_EDGEONE_API_TOKEN=
AIRINGCAL_EDGEONE_TEAM_ID=
AIRINGCAL_EDGEONE_PROJECT=
AIRINGCAL_EDGEONE_REGION=overseas
# optional S3 overrides only if token self-derivation lacks object access
# AIRINGCAL_S3_ACCESS_KEY_ID=
# AIRINGCAL_S3_SECRET_ACCESS_KEY=

# Immutable planned resource names (not Owner-editable defaults that can silently drift):
# - Bucket: airingcal-production
# - GitHub Environment: production
# - Writer gate var: AIRINGCAL_WRITER_ENABLED (must remain unset/false in this prep)
# - CF Worker / EdgeOne project names: placeholders validated at preflight
#   (do not reuse Development worker/project names)
