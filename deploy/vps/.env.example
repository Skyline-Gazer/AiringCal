# Copy to .env, replace every placeholder, and run: chmod 600 .env
# VPS_SYNC_IMAGE must be an existing immutable production image tag.
VPS_SYNC_IMAGE=ghcr.io/skyline-gazer/airing-cal-sync:0000000000000000000000000000000000000000

# PostgreSQL and upstream credentials stay in this private file.
DATABASE_URL=postgresql://user:password@db.example.invalid:5432/airing_cal?sslmode=require
BANGUMI_TOKEN=replace-with-bangumi-access-token
BANGUMI_USERS=replace-with-usernames

# Cloudflare R2 S3-compatible endpoint and least-privilege credentials.
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_BUCKET=airing-cal-data
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# Feishu custom-bot notification settings.
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace-with-webhook-id
FEISHU_WEBHOOK_TOKEN=
FEISHU_WEBHOOK_SECRET=
FEISHU_TIMEOUT_MS=10000
