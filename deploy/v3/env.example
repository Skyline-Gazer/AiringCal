# Portable v3 Compose — copy to deploy/v3/.env (gitignored locally)

AIRINGCAL_PLATFORM=portable
AIRINGCAL_WEB_PORT=8787
NSFW_SHOW=false
BANGUMI_GIT_COMMIT_SHA=local-dev

AIRINGCAL_USERS_JSON=[{"userId":"YOUR_ID","username":"you"}]
AIRINGCAL_PRIMARY_USER_ID=YOUR_ID
BGM_TOKEN=

AIRINGCAL_BUILDER_MEDIA_REFRESH=refresh
AIRINGCAL_BUILDER_PUBLISH=true
AIRINGCAL_BUILDER_MODE=incremental

# Scheduler profile (docker compose --profile scheduler)
AIRINGCAL_SCHEDULER_DAILY_AT=03:00
AIRINGCAL_SCHEDULER_FULL_EVERY_DAYS=7
AIRINGCAL_SCHEDULER_RUN_ON_START=false
AIRINGCAL_SCHEDULER_BACKUP_BEFORE_SYNC=true

AIRINGCAL_GC_MIN_GENERATIONS=5
AIRINGCAL_GC_MIN_AGE_DAYS=30
AIRINGCAL_GC_LOG_AFTER_PUBLISH=true

AIRINGCAL_BUILDER_BACKUP_DIR=/data/backups
AIRINGCAL_BUILDER_BACKUP_KEEP=10
