# AiringCal v3 — Local Staging Initialization Configuration (.env.example)
# Copy this file to `.env` (git-ignored) and fill in the values below, then run:
#   bash scripts/setup-staging.sh
#
# Unified naming convention: AIRINGCAL_{ENVIRONMENT}_{SERVICE}_{KEY}
# Never commit `.env` or upload it to any remote Worker.

# --- Required Staging Configuration (3 Secrets + 1 Business Variable) ---
AIRINGCAL_STAGING_BANGUMI_TOKEN=
AIRINGCAL_STAGING_PRIMARY_USER_ID=
AIRINGCAL_STAGING_S3_ACCESS_KEY_ID=
AIRINGCAL_STAGING_S3_SECRET_ACCESS_KEY=

# --- Optional Cloudflare Auth (if not already logged in via `wrangler login` or `CLOUDFLARE_API_TOKEN`) ---
# Setup token: Workers R2 Storage Write + Workers Scripts Write on the target account.
# S3 Object Read & Write credentials above do not replace bucket-management permission.
AIRINGCAL_STAGING_CLOUDFLARE_API_TOKEN=

# --- Optional Overrides (auto-derived via Bangumi API / Wrangler CLI when left empty) ---
AIRINGCAL_STAGING_USERS_JSON=
AIRINGCAL_STAGING_CLOUDFLARE_ACCOUNT_ID=
AIRINGCAL_STAGING_PUBLIC_BASE_URL=
