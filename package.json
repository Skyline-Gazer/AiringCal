{
  "name": "airing-cal",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "render your bangumi.tv progress on a static web page",
  "scripts": {
    "dev": "pnpm -F @airing-cal/frontend-worker dev",
    "deploy": "pnpm -r --filter './apps/*' --if-present deploy",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build:check": "pnpm -r --if-present build:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markd3ng/AiringCal.git"
  },
  "keywords": [
    "bangumi",
    "anime"
  ],
  "author": "markd3ng",
  "license": "MIT",
  "dependencies": {
    "@fission-ai/openspec": "^1.4.1"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.x"
  }
}
