{
  "name": "airing-cal",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Personal Bangumi anime airing calendar and viewing-progress presentation application",
  "scripts": {
    "setup": "node scripts/setup-wizard.mjs",
    "dev": "pnpm -F @airing-cal/v3-read-worker dev",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.e2e.json",
    "test": "pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "build:check": "pnpm -r --if-present build:check",
    "lint:undefined": "node scripts/check-undefined-identifiers.mjs",
    "e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skyline-Gazer/AiringCal.git"
  },
  "keywords": [
    "bangumi",
    "anime",
    "cloudflare-workers",
    "cloudflare-r2",
    "github-actions"
  ],
  "author": "markd3ng",
  "license": "MIT",
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@types/node": "^26.4.0",
    "@playwright/test": "^1.65.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "wrangler": "^4.x"
  }
}
